<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Design tokens -->
        <Thickness x:Key="SpacingXs">4</Thickness>
        <Thickness x:Key="SpacingSm">8</Thickness>
        <Thickness x:Key="SpacingMd">12</Thickness>
        <Thickness x:Key="SpacingLg">16</Thickness>

        <x:Double x:Key="ControlMinHeight">34</x:Double>
        <x:Double x:Key="TitleFontSize">17</x:Double>
        <x:Double x:Key="BodyFontSize">13</x:Double>
        <x:Double x:Key="CaptionFontSize">12</x:Double>

        <CornerRadius x:Key="RadiusSm">8</CornerRadius>
        <CornerRadius x:Key="RadiusMd">12</CornerRadius>
        <CornerRadius x:Key="RadiusLg">16</CornerRadius>

        <Color x:Key="BrandColor">#4F7DFF</Color>
        <Color x:Key="BrandSoftColor">#2A4F7DFF</Color>
        <Color x:Key="SurfaceColor">#FF171A20</Color>
        <Color x:Key="SurfaceMutedColor">#FF1F2430</Color>
        <Color x:Key="SurfaceCardColor">#FF242B38</Color>
        <Color x:Key="BorderColor">#FF334054</Color>
        <Color x:Key="TextSecondaryColor">#FFAAB4C6</Color>
        <Color x:Key="SuccessColor">#FF2EBD85</Color>
        <Color x:Key="WarningColor">#FFF4B543</Color>
        <Color x:Key="DangerColor">#FFF06464</Color>

        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
        <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Opacity" Value="0.84" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}" />
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Margin" Value="{StaticResource SpacingXs}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox#NavListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox#NavListBox > ListBoxItem">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="ListBox#NavListBox > ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
    </Style>

    <Style Selector="ListBox#NavListBox > ListBoxItem:pointerover">
        <Setter Property="Background" Value="#223A4661" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{StaticResource BrandSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="#223A4661" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="Border.section">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>

    <Style Selector="Border.resize-splitter">
        <Setter Property="Width" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Margin" Value="0,28" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Window.config-mode Border.resize-splitter">
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Background" Value="#40FFFFFF" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Window.config-mode Border.resize-splitter:pointerover">
        <Setter Property="Background" Value="#70FFFFFF" />
    </Style>

    <Style Selector="Border.resize-edge">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Window.config-mode Border.resize-edge">
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="StackPanel.action-panel > Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

</Styles>
